{
  "expo": {
    "name": "ABESS VPN Control",
    "slug": "abessvpn-mobile",
    "scheme": "abessvpn",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "enablePngCrunchInReleaseBuilds": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "webpAnimated": false,
            "networkInspector": false
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.abessvpn.panel",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.abessvpn.panel",
      "versionCode": 4
    }
  }
}
