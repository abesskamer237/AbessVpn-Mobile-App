{
  "expo": {
    "name": "ABESS VPN Control",
    "slug": "abessvpn-mobile",
    "scheme": "abessvpn",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.abessvpn.panel",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.abessvpn.panel",
      "versionCode": 3
    }
  }
}
